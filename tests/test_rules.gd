extends SceneTree

const Puzzle = preload("res://scripts/puzzle.gd")
const Store = preload("res://scripts/save_store.gd")
var failures := 0
var checks := 0

func verify(ok: bool, reason: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		push_error(reason)

func walk(puzzle, letters: String) -> void:
	for letter in letters:
		var old: Vector2i = puzzle.player()
		var t: int = puzzle.tick()
		verify(puzzle.move(Puzzle.DIRECTIONS[letter]), "Legal reference move: %s / %d / %s" % [puzzle.level.id,t,letter])
		var delta: Vector2i = puzzle.player() - old
		verify((absi(delta.x)+absi(delta.y)==1 or not puzzle.portals.is_empty() or not puzzle.currents.is_empty()) and puzzle.tick()==t+1, "One input advances exactly one beat")

func fixture(catalog: Array, id: String) -> Dictionary:
	return catalog.filter(func(room): return room.id == id)[0]

func _initialize() -> void:
	var catalog: Array = JSON.parse_string(FileAccess.get_file_as_string("res://data/levels.json"))
	var extra: Array = JSON.parse_string(FileAccess.get_file_as_string("res://data/extra.json"))
	for level in catalog + extra:
		var p = Puzzle.new(level)
		verify(not p.move(Vector2i.ZERO) and not p.move(Vector2i(1,1)) and p.tick()==0, "No waiting or diagonals")
		for route in level.recordings:
			walk(p, route)
			verify(p.seal() and p.tick()==0 and p.player()==p.start, "Recording restarts the room")
		walk(p, level.final)
		verify(p.cleared() and not p.seal(), "Only the current player finishes")
		var restored = Puzzle.new(level)
		verify(restored.restore(JSON.parse_string(JSON.stringify(p.snapshot()))) and restored.snapshot()==p.snapshot(), "Snapshot replay: "+level.id)
	var switchyard: Dictionary = extra.filter(func(level): return level.id == "X04")[0]
	var alternatives: Array = JSON.parse_string(FileAccess.get_file_as_string("res://tests/switchyard_routes.json"))
	for plan in alternatives:
		var branch = Puzzle.new(switchyard)
		for recording in plan.recordings:
			walk(branch, recording)
			verify(branch.seal(), "Record an alternate Switchyard route")
		walk(branch, plan.final)
		verify(branch.cleared(), "Alternate Switchyard entrance reaches the exit")
	var p = Puzzle.new(fixture(catalog, "01"))
	walk(p,"UU")
	verify(p.seal(), "Can record two moves")
	walk(p,"RR")
	verify(p.echo_position(0)==p.plates.A and p.gate_open(p.gates[0]), "Last recorded cell opens gate")
	walk(p,"R")
	verify(p.echo_position(0)==null and not p.gate_open(p.gates[0]), "Cross using prior occupancy; echo expires and door closes")
	verify(p.undo() and p.tick()==2 and p.gate_open(p.gates[0]), "Undo restores disappeared echo")
	p.restart_round()
	walk(p,"RLRR")
	verify(not p.move(Vector2i.RIGHT) and p.tick()==4, "A missed window stays closed")
	verify(p.rerecord_last() and p.echoes.is_empty() and p.tick()==2, "Editing restores the last draft")
	walk(p,"DU")
	verify(p.seal(), "Can record a second visit")
	walk(p,"RLRRRR")
	verify(p.cleared(), "Second pulse allows a later crossing")
	var before: Dictionary = p.snapshot()
	var forged: Dictionary = before.duplicate(true)
	forged.echoes[0].insert(1, forged.echoes[0][0])
	verify(not p.restore(forged) and p.snapshot()==before, "Reject a stationary saved step without mutating session")
	forged = before.duplicate(true)
	forged.echoes.clear()
	verify(not p.restore(forged) and p.snapshot()==before, "Reject a replay depending on a missing echo")
	var dual = Puzzle.new(fixture(catalog, "06"))
	for route in fixture(catalog, "06").recordings:
		walk(dual, route)
		verify(dual.seal(), "Causal recordings valid")
	walk(dual,"L")
	var original_plan: Dictionary = dual.snapshot()
	verify(dual.rerecord_last() and dual.echoes.size()==1 and dual.tick()==6, "Modify latest recording, retain earlier recording")
	var editing = Puzzle.new(fixture(catalog, "06"))
	verify(editing.restore(JSON.parse_string(JSON.stringify(dual.snapshot()))) and editing.cancel_edit() and editing.snapshot()==original_plan, "Resuming an edit preserves the option to restore the full original plan")
	verify(dual.undo() and dual.seal() and dual.undo() and dual.echoes.size()==1 and dual.tick()==5, "Undo across a seal boundary")
	var path := "user://rule-test-%d.json" % OS.get_process_id()
	var store = Store.new(path)
	store.data.session = dual.snapshot()
	verify(store.flush(), "Atomic save")
	var loaded = Store.new(path)
	verify(dual.restore(loaded.data.session), "Reload actual saved session")
	DirAccess.remove_absolute(path)
	_test_devices(catalog)
	_test_lens(catalog)
	_test_silence(catalog)
	_test_direction_switches(fixture(catalog, "21"))
	_test_lava(catalog)
	_test_paradox(extra[1])
	print("ECHO rules: %d checks; %d failures." % [checks, failures])
	quit(1 if failures else 0)

func _test_paradox(level: Dictionary) -> void:
	var p = Puzzle.new(level)
	for route in level.recordings:
		walk(p, route)
		verify(p.seal(), "Paradox recordings validate against older recordings")
	walk(p, level.final.left(14))
	verify(p.plate_on("@") and p.plate_on("C") and p.gate_open(p.gates[3]), "Three echoes open the remote lens-and-C gate")
	verify(p.mechanism_state() == 1 and not p.bridge_active(Vector2i(2,0),1), "The recording in C folds the gallery bridges")
	walk(p, level.final.substr(14,1))
	verify(p.echo_position(2) == null and p.echo_position(0) == Vector2i(2,0) and p.echo_position(1) == Vector2i(4,0), "The C echo fades as both older echoes cross folded bridges")
	verify(p.undo() and p.plate_on("@") and p.plate_on("C"), "Undo restores the meeting and the fading echo")
	walk(p, level.final.substr(14))
	verify(p.cleared(), "West plan finishes after undoing the coordinated crossing")
	for plan in JSON.parse_string(FileAccess.get_file_as_string("res://tests/paradox_routes.json")):
		var alternate = Puzzle.new(level)
		for route in plan.recordings:
			walk(alternate, route)
			verify(alternate.seal(), "Record an alternate Paradox ending")
		walk(alternate, plan.final)
		verify(alternate.cleared(), "Each Paradox exit is playable")
		var restored = Puzzle.new(level)
		verify(restored.restore(alternate.snapshot()), "Paradox saves replay all three causal recordings")

func _test_lava(catalog: Array) -> void:
	var fixture := {"id": "lava", "rows": ["S2143X", "......"], "gates": [], "max_echoes": 1, "lava_groups": 4}
	var cycle = Puzzle.new(fixture)
	var initial: Dictionary = cycle.snapshot()
	verify(cycle.lava_phase() == 0 and not cycle.move(Vector2i.RIGHT), "The next sinking group blocks landing")
	verify(cycle.snapshot() == initial and cycle.tick() == 0, "Unsafe input costs no beat or device change")
	walk(cycle, "DRU")
	verify(cycle.lava_phase() == 3 and cycle.player() == Vector2i(1,0), "A recovered group can be entered at a later phase")
	verify(not cycle.move(Vector2i.RIGHT) and cycle.tick() == 3, "A currently solid group can be unsafe on arrival")
	verify(cycle.undo() and cycle.lava_phase() == 2, "Undo restores the lava cycle")
	walk(cycle, "RL")
	verify(cycle.tick() == 4 and cycle.lava_phase() == 0, "The four-phase cycle wraps")
	verify(cycle.seal() and cycle.tick() == 0 and cycle.lava_phase() == 0, "Leaving an echo resets the cycle")
	var rising = Puzzle.new({"id": "rising", "rows": ["S1.X"], "gates": [], "max_echoes": 1, "lava_groups": 4})
	verify(not rising.lava_safe(Vector2i(1,0),0) and rising.move(Vector2i.RIGHT), "A currently submerged group rises as the player lands")
	var forged := initial.duplicate(true)
	forged.draft.append([1,0])
	verify(not Puzzle.new(fixture).restore(forged), "Saves reject routes landing on lava")
	for plan in JSON.parse_string(FileAccess.get_file_as_string("res://tests/inferno_routes.json")):
		var branch = Puzzle.new(fixture(catalog, plan.id))
		for route in plan.recordings:
			walk(branch, route)
			verify(branch.seal(), "Alternate Inferno recording is legal")
		walk(branch, plan.final)
		verify(branch.cleared(), "Alternate Inferno approach clears the room")
	for level in catalog.filter(func(r): return r.chapter == "Inferno"):
		var room = Puzzle.new(level)
		for route in room.level.recordings:
			walk(room, route)
			room.seal()
		for letter in room.level.final:
			room.move(Puzzle.DIRECTIONS[letter])
			for actor in room.occupied():
				verify(room.lava_safe(actor, room.tick()), "Player and validated echoes occupy safe tiles")
		verify(room.undo() and room.lava_phase() == (room.tick() % 4), "Undo remains exact after an Inferno clear")
		var restored = Puzzle.new(room.level)
		verify(restored.restore(room.snapshot()) and restored.lava_phase() == room.lava_phase(), "Saved Inferno routes restore their phase")

func _test_direction_switches(level: Dictionary) -> void:
	var ride = Puzzle.new(level)
	for tape in level.recordings:
		walk(ride, tape)
		verify(ride.seal(), "Carousel recordings are legal")
	walk(ride, level.final.left(3))
	verify(ride.mechanism_state() == 6, "Two echoes on one switch flip its linked doors only once")
	walk(ride, level.final.substr(3, 5))
	verify(ride.player() == Vector2i(4,3) and ride.mechanism_state() == 6, "Entering the ride does not reverse the controlled door")
	walk(ride, level.final.substr(8, 3))
	verify(ride.mechanism_state() == 0 and ride.player() == Vector2i(6,2), "Remote echo changes the exit while the player is inside")
	verify(ride.undo() and ride.mechanism_state() == 6, "Undo restores the remote switch and doors")
	walk(ride, level.final.substr(10))
	verify(ride.cleared(), "Carousel completes after undoing a switch visit")
	ride.reset_all()
	for tape in level.recordings:
		walk(ride, tape)
		ride.seal()
	walk(ride, "UUDDRRRRDRRURR")
	verify(ride.cleared(), "The lower ring is also a playable route")

func _test_devices(catalog: Array) -> void:
	var turn = Puzzle.new(fixture(catalog, "07"))
	walk(turn, "UURR")
	verify(turn.turn_direction(0,turn.mechanism_state())==Vector2i.LEFT, "Crossing reverses the arrow")
	verify(turn.undo() and turn.turn_direction(0,turn.mechanism_state())==Vector2i.RIGHT, "Undo restores direction")
	walk(turn,"R")
	verify(turn.seal() and turn.mechanism_state()==0, "Sealing resets turnstiles")
	walk(turn,"UURR")
	verify(turn.mechanism_state()==2, "Two simultaneous crossings reverse the arrow once")
	var before: Dictionary = turn.snapshot()
	var restored = Puzzle.new(fixture(catalog, "07"))
	verify(restored.restore(before) and restored.mechanism_state()==2, "Restore reconstructs shared turnstile state")
	turn.restart_round()
	verify(turn.mechanism_state()==0 and turn.rerecord_last() and turn.mechanism_state()==2, "Editing reconstructs the historical board")
	verify(turn.cancel_edit() and turn.mechanism_state()==0, "Cancelling an edit restores the correct round")
	var bridge = Puzzle.new(fixture(catalog, "08"))
	walk(bridge,"RR")
	verify(not bridge.move(Vector2i.RIGHT) and bridge.tick()==2, "Folded bridge rejects entry without advancing time")
	bridge.restart_round()
	walk(bridge,"UUDU")
	verify(bridge.seal(), "Record two diamond visits")
	walk(bridge,"RRRR")
	verify(bridge.mechanism_state()==0 and bridge.can_move(Vector2i.RIGHT), "Second switch restores the exit bridge")
	verify(bridge.undo() and bridge.mechanism_state()==1, "Undo restores a folded bank")
	var footing = Puzzle.new({"id":"footing","rows":["*###",".###","S.bX"],"gates":[],"max_echoes":1})
	walk(footing,"UUDU")
	verify(footing.seal(), "Record bridge switches for the footing case")
	walk(footing,"RLRR")
	verify(not footing.bridge_active(footing.player(),footing.mechanism_state()) and footing.can_move(Vector2i.RIGHT), "An actor can step off a newly folded bridge")
	var resumed = Puzzle.new(footing.level)
	verify(resumed.restore(footing.snapshot()) and resumed.move(Vector2i.RIGHT) and resumed.cleared(), "Save on a folded bridge resumes correctly")
	var under = Puzzle.new(fixture(catalog, "09"))
	walk(under,under.level.recordings[0])
	verify(under.seal(), "Record the lower lane")
	walk(under,"RRUDU")
	verify(under.echo_position(0)==under.player() and (under.mechanism_state() & 1)==0, "Simultaneous arrivals swap the banks once")
	walk(under,"ULL")
	verify(under.echo_position(0)==Vector2i(4,2) and not under.bridge_active(Vector2i(4,2),under.mechanism_state()), "A recorded route survives a later bridge change")
	var loaded = Puzzle.new(fixture(catalog, "09"))
	verify(loaded.restore(under.snapshot()) and loaded.mechanism_state()==under.mechanism_state(), "Mid-puzzle save restores both mechanisms")
	walk(loaded,"LUU")
	verify(loaded.cleared(), "Resumed dynamic room can finish")

func _test_lens(catalog: Array) -> void:
	var lens = Puzzle.new(fixture(catalog, "11"))
	walk(lens, "LUUR")
	verify(not lens.plate_on(Puzzle.LENS) and not lens.move(Vector2i.UP), "One actor cannot open the lens gate")
	verify(lens.seal(), "Record a route ending at the lens")
	walk(lens, "RUUL")
	verify(lens.plate_on(Puzzle.LENS), "The echo's final beat counts for the lens")
	walk(lens, "U")
	verify(not lens.plate_on(Puzzle.LENS) and lens.undo() and lens.plate_on(Puzzle.LENS), "Undo restores the last shared beat")
	var restored = Puzzle.new(lens.level)
	verify(restored.restore(lens.snapshot()) and restored.move(Vector2i.UP), "A saved rendezvous can resume through the gate")
	var finale = Puzzle.new(fixture(catalog, "14"))
	for route in finale.level.recordings:
		walk(finale, route)
		verify(finale.seal(), "Record a return journey for Totality")
	walk(finale, finale.level.final.substr(0, 7))
	verify(finale.plate_on(Puzzle.LENS) and finale.player() != finale.plates[Puzzle.LENS], "Two echoes can open a lens far from the player")
	walk(finale, finale.level.final.substr(7, 3))
	for i in finale.echoes.size():
		var cell: Vector2i = finale.echo_position(i)
		verify(not finale.bridge_active(cell, finale.mechanism_state()), "After the rendezvous each tape crosses its folded bridge")

func _test_silence(catalog: Array) -> void:
	var hush = Puzzle.new(fixture(catalog, "15"))
	walk(hush, "UUDU")
	verify(hush.seal(), "Record a return visit to A")
	walk(hush, "RRRR")
	var before: Dictionary = hush.snapshot()
	verify(not hush.move(Vector2i.RIGHT) and hush.snapshot()==before, "An occupied silence plate blocks without consuming a beat")
	walk(hush, "LRR")
	verify(hush.cleared(), "Pacing lets the echo fade and opens the silence gate")
	var last = Puzzle.new(fixture(catalog, "17"))
	walk(last, "LLUURRRL")
	verify(last.seal(), "Record a later return to the lens")
	walk(last, "RRUULL")
	verify(last.seal(), "The other echo ends on its first meeting")
	walk(last, "DDRRRDDD")
	verify(not last.plate_on(Puzzle.LENS) and not last.gate_open(last.gates[-1]), "One remaining self keeps a silence lens shut even though it is no longer activated")
	var restored = Puzzle.new(fixture(catalog, "17"))
	verify(restored.restore(last.snapshot()) and not restored.can_move(Vector2i.DOWN), "A saved silence gate restores its occupancy")
	walk(last, "UDD")
	verify(last.cleared() and last.undo() and last.undo() and last.undo() and not last.can_move(Vector2i.DOWN), "Undo restores the echo and closes the silence gate again")
